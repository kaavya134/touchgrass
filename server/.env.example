# Copy to .env. Never commit real credentials.
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/touchgrass

# OpenAI-compatible provider supporting image input and JSON responses.
AI_BASE_URL=https://your-provider.example/v1
AI_MODEL=your-vision-capable-model
AI_API_KEY=

# Generate a unique value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
FRONTEND_ORIGINS=http://localhost:5173
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HOPS=
